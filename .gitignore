# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.ruff_cache
# Virtual environments
.venv
.pytest_cache
# Snakemake's per-invocation metadata and logs
.snakemake
# Run artifacts: smoke-test logs, predicted structures, frozen design sets.
# A design set is content-addressed and rebuildable from its recorded query
# (docs/scoring-stage.md section 2), so the campaign's sets live beside the
# database rather than in the repository.
build-logs/
design_sets/
# Figures and other binaries live outside the repo, under
# binder_design/docs/figures/. A plot is a run artifact: it is regenerated by a
# committed script from data that is itself too large to track, so versioning
# the picture only adds weight and merge conflicts.
*.png
*.jpg
*.jpeg
*.gif
*.pdf
