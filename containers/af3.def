Bootstrap: docker
From: nvidia/cuda:12.6.3-base-ubuntu24.04@sha256:c87e78933f4c16e3272123bf2f75537306596d0fbaa395a29696a22786e5ee0e

# AlphaFold 3, x86_64. Translated from the upstream docker/Dockerfile with two
# deliberate departures, both about the weights.
#
# 1. THE WEIGHTS ARE NOT IN THE IMAGE. af3.bin.zst is governed by
#    WEIGHTS_TERMS_OF_USE.md (non-commercial; §2 restricts distribution), so
#    baking it into a SIF would make every copy of that file a redistribution.
#    It is bound read-only at run time from $AF3_MODELS instead. This is the
#    opposite of chai1.def, whose assets are Apache-2.0 and embedded -- the
#    licence, not convenience, is what decides.
#
# 2. NO GENETIC DATABASES. The upstream data pipeline wants ~630 GB of BFD,
#    UniRef and MGnify. We never run it: the campaign already has a ColabFold
#    a3m for the target, and AF3 accepts it directly as `unpairedMsa` in the
#    input JSON (docs/input.md:206). So this image is inference-only and is
#    launched with --norun_data_pipeline. HMMER is still built, because
#    run_alphafold.py imports the pipeline module at start-up even when it is
#    told not to run it.
#
# Build (CPU allocation, needs network for apt/PyPI, ~30 GB scratch):
#   cd /n/.../binder_design/alphafold3
#   singularity build --fakeroot ../images/af3.sif af3.def
#
# Run (GPU, weights bound read-only):
#   singularity exec --nv --cleanenv \
#     -B /abs/work:/work -B /abs/af3_models:/models:ro \
#     ../images/af3.sif \
#     python /app/alphafold/run_alphafold.py \
#       --json_path=/work/fold_input.json --model_dir=/models \
#       --output_dir=/work/out --norun_data_pipeline
#
# CUDA capability 7 GPUs need XLA_FLAGS="--xla_disable_hlo_passes=custom-kernel-fusion-rewriter"
# instead of the value set below; the cluster's H100s (capability 9) do not.

%labels
    Upstream      https://github.com/google-deepmind/alphafold3
    WeightsPolicy BoundReadOnly-NotEmbedded
    WeightsTerms  WEIGHTS_TERMS_OF_USE.md (non-commercial)
    DataPipeline  disabled-inference-only
    CudaBase      12.6.3-base-ubuntu24.04

%files
    . /app/alphafold

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update --quiet
    # git is needed by the pyproject toolchain's CMakeLists; gcc/g++/make and
    # zlib build HMMER and AF3's own C++ extensions; zstd decompresses the
    # parameter file at load.
    apt-get install --yes --quiet --no-install-recommends \
        python3.12 python3.12-dev git wget ca-certificates \
        gcc g++ make zlib1g-dev zstd patch
    rm -rf /var/lib/apt/lists/*

    # uv, pinned exactly as upstream pins it.
    export UV_INSTALL_DIR=/usr/local/bin
    curl_or_wget() { wget -qO- "$1"; }
    wget -qO /tmp/uv-installer.sh https://astral.sh/uv/0.9.24/install.sh
    sh /tmp/uv-installer.sh
    rm /tmp/uv-installer.sh
    uv --version

    export UV_COMPILE_BYTECODE=1
    export UV_PROJECT_ENVIRONMENT=/alphafold3_venv
    uv venv $UV_PROJECT_ENVIRONMENT
    export PATH="/hmmer/bin:/alphafold3_venv/bin:$PATH"

    # HMMER 3.4 from source, hash-checked, with upstream's --seq_limit patch.
    # eddylab.org has no HTTPS and upstream explicitly warns against the
    # GitHub tarball, so the sha256 check is the integrity guarantee, not the
    # transport.
    mkdir /hmmer_build /hmmer
    wget http://eddylab.org/software/hmmer/hmmer-3.4.tar.gz --directory-prefix /hmmer_build
    cd /hmmer_build
    echo "ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3  hmmer-3.4.tar.gz" | sha256sum --check
    tar zxf hmmer-3.4.tar.gz && rm hmmer-3.4.tar.gz
    patch -p0 < /app/alphafold/docker/jackhmmer_seq_limit.patch
    cd /hmmer_build/hmmer-3.4 && ./configure --prefix /hmmer && make -j"$(nproc)" && make install
    cd /hmmer_build/hmmer-3.4/easel && make install
    rm -rf /hmmer_build

    cd /app/alphafold
    # --frozen pins the lockfile; --no-editable installs statically so the
    # image does not depend on /app/alphafold staying writable.
    UV_LINK_MODE=copy uv sync --frozen --all-groups --no-editable
    # The chemical component dictionary, built once here rather than on every
    # first run (it writes into the package directory, which is read-only at
    # run time).
    uv run build_data

    mkdir -p /models /work

%environment
    export PATH="/hmmer/bin:/alphafold3_venv/bin:$PATH"
    # Upstream's workaround for an XLA issue that otherwise inflates
    # compilation time enormously.
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_PYTHON_CLIENT_PREALLOCATE=true
    export XLA_CLIENT_MEM_FRACTION=0.95
    export PYTHONNOUSERSITE=1
    export PYTHONUNBUFFERED=1
    export LANG=C.UTF-8

%runscript
    exec python /app/alphafold/run_alphafold.py "$@"

%test
    set -eu
    export PATH="/hmmer/bin:/alphafold3_venv/bin:$PATH"
    python -c "import alphafold3; print('alphafold3 imports')"
    python -c "from alphafold3.model import params; print('params module OK')"
    jackhmmer -h > /dev/null && echo "hmmer OK"
    # Import the entry point and read a flag off it, rather than running
    # `--help`: absl exits 1 on --help, which fails a `set -e` %test and looks
    # like a broken image when nothing is wrong.
    #
    # No weights and no GPU here: this proves the image is complete, not that a
    # fold runs. It also asserts the two things this image deliberately does
    # NOT ship -- weights and databases -- are absent, so a later build that
    # quietly bakes them in fails here instead of shipping restricted bytes.
    python -c "
import sys; sys.path.insert(0, '/app/alphafold')
import run_alphafold
assert run_alphafold.MODEL_DIR is not None
print('run_alphafold imports; flags wired')"
    test ! -e /models/af3.bin.zst || { echo "FAIL: weights baked into the image"; exit 1; }
    echo "weights absent from the image, as intended"

%help
    AlphaFold 3, inference only. Model parameters are NOT in this image; bind
    them read-only and pass --model_dir. Use is governed by
    WEIGHTS_TERMS_OF_USE.md (non-commercial).

    Genetic databases are absent by design. Supply the target alignment in the
    input JSON as `unpairedMsa` and pass --norun_data_pipeline.
