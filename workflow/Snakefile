# Generation: authored config -> designs in DuckDB, for any registered tool.
#
#   prepare_run
#        |
#        +--> generate[task=0..N] --> collect --> ingest
#                                                   |
#                                                   v
#                                            generation_complete
#
# No rule names a tool. Each model config declares its own `tool:`, and the
# plugin for that tool supplies the task count, the command, the resources, and
# the adapter. Adding a tool changes this file not at all.
#
# The index names executions rather than deriving them from filenames:
#
#   runs:
#     - name: mosaic-run-12
#       config: /path/to/mosaic.yaml
#
# Run:
#   uv run snakemake --configfile <index>.yaml --profile workflow/profiles/slurm

from pathlib import Path

from bindocracy.runs.index import read_workflow_index
from bindocracy.runs.steps import collect_step, generate_step, ingest_step, prepare_step
from bindocracy.tools import load_configs, plugin_for, resources

INDEX = read_workflow_index(config)
RUN_ROOT = INDEX.run_root
DATABASE = INDEX.database

# Validated at DAG time, so a bad config fails in a second rather than in the
# queue. This is also where the task count comes from, which is why no
# checkpoint is needed to know the shape of the fan-out.
LOADED = {
    request.name: load_configs(INDEX.general_config, request.config)
    for request in INDEX.runs
}
TASKS = {
    name: [f"{task_id:04d}" for task_id in range(plugin_for(loaded.tool).tool_plan(loaded).jobs)]
    for name, loaded in LOADED.items()
}


def slurm(field):
    """One launch resource, resolved at DAG time from the configs alone."""
    return lambda wildcards: resources(LOADED[wildcards.run])[field]


def config_inputs(wildcards):
    """The authored YAML this run was planned from.

    Declared so that editing a config re-runs prepare_run, where reuse
    validation either accepts the manifest or refuses it loudly. Without this,
    a changed config could sit behind an untouched run.json while the launch
    used different values.
    """
    loaded = LOADED[wildcards.run]
    return [str(loaded.general_path), str(loaded.model_path)]


# Everything except the GPU work runs on the submitting host.
localrules: all, prepare_run, collect, ingest, generation_complete


rule all:
    input:
        expand(str(RUN_ROOT / "{run}" / "generation.done"), run=list(LOADED)),


rule prepare_run:
    """Create or reuse the run identity, directory, and archived inputs."""
    input:
        config_inputs,
    output:
        RUN_ROOT / "{run}" / "run.json",
    log:
        RUN_ROOT / "{run}" / "logs" / "prepare.log",
    run:
        prepare_step(LOADED[wildcards.run], RUN_ROOT / wildcards.run, wildcards.run, log[0])


rule generate:
    """One GPU task, however this tool runs one."""
    input:
        RUN_ROOT / "{run}" / "run.json",
    output:
        RUN_ROOT / "{run}" / "tasks" / "{task}" / "status.json",
    log:
        RUN_ROOT / "{run}" / "logs" / "task-{task}.log",
    resources:
        slurm_account=slurm("slurm_account"),
        slurm_partition=slurm("slurm_partition"),
        gres=slurm("gres"),
        cpus_per_task=slurm("cpus_per_task"),
        mem_mb=slurm("mem_mb"),
        runtime=slurm("runtime"),
    run:
        generate_step(input[0], int(wildcards.task), log[0], output[0])


rule collect:
    """Parse every planned task, keeping whatever partial work exists."""
    input:
        manifest=RUN_ROOT / "{run}" / "run.json",
        tasks=lambda wildcards: expand(
            str(RUN_ROOT / wildcards.run / "tasks" / "{task}" / "status.json"),
            task=TASKS[wildcards.run],
        ),
    output:
        RUN_ROOT / "{run}" / "collected.json",
    log:
        RUN_ROOT / "{run}" / "logs" / "collect.log",
    run:
        collect_step(input.manifest, output[0], log[0])


rule ingest:
    """The only DuckDB writer. db_writer serializes it across tools."""
    input:
        RUN_ROOT / "{run}" / "collected.json",
    output:
        RUN_ROOT / "{run}" / "ingested.json",
    log:
        RUN_ROOT / "{run}" / "logs" / "ingest.log",
    resources:
        db_writer=1,
    run:
        ingest_step(DATABASE, input[0], output[0], log[0])


rule generation_complete:
    input:
        RUN_ROOT / "{run}" / "ingested.json",
    output:
        touch(RUN_ROOT / "{run}" / "generation.done"),
